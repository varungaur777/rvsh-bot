# Copy to .env and fill in. Secrets never go into git.

# --- Telegram ---
API_ID=
API_HASH=
BOT_TOKEN=
IMAGE_BOT_TOKENS=          # comma-separated uploader bot tokens (may be empty)
OWNER_ID=
DUMP_CHANNEL_ID=           # -100…
IMAGE_DUMP_CHANNEL_ID=     # -100… (quiz cards are stored here)
QUIZ_DUMP_CHANNEL_ID=      # -100… every new quiz gets a post here to play it (its JSON goes to DUMP_CHANNEL_ID; empty = DUMP_CHANNEL_ID); the main bot must be admin
BRANDING=@NotesHub_Ssc

# --- storage ---
MONGO_URL=                 # MONGO_URI is accepted too
DOWNLOAD_ROOT=./downloads
# ENV_FILE (environment only): where this file is — Docker sets /data/.env so /bot edits survive a new container

# --- optional ---
TESSERACT_CMD=
HTTP_PROXY=
FETCH_API_URL=             # optional remote fetch server (tools/fetch_server)
FETCH_API_TOKEN=
# Must-join channels (force-subscribe): IDs (-100…) or @usernames, comma-separated. The bot must be an admin there.
# Also settable in /bot → Must-join channels. Admins and the owner are never asked to join.
FORCE_SUB_CHANNELS=
WEBAPP_PORT=8080
WEBAPP_HOST=               # 127.0.0.1 (default) · 0.0.0.0 when the host gives HTTPS itself (then WEBAPP_BASE_URL + /qz tunnel off)
WEBAPP_BASE_URL=
CLOUDFLARED_TOKEN=
CLOUDFLARED_CMD=
RUNTIME_PROFILE=           # persistent | colab | github_actions | windows_dev (auto when empty)
DATA_PERSISTENT=           # true/false override
SESSION_STRING=
